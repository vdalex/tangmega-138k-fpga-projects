// Tang Mega 138K (GW5AST-LV138PG484AC1/I0) - AE350 bring-up pinout.
//
// The AE350 core clock arrives over a DEDICATED path from PLL_R[0]'s clkout1,
// so the PLL feeding CORE_CLK must be pinned there or the CPU simply never
// gets a clock (Gowin MUG1030 "Quick Start", sec. 2.6.4 Physical Constraint).
INS_LOC "pll0/PLL_inst" PLL_R[0];

// Pins taken from the Sipeed ddr_memory_test_uart example, which drives the
// same on-board BL616 USB-serial bridge (nets BL616_IO28_TX / IO27_RX).

IO_LOC  "clk" V22;
IO_PORT "clk" IO_TYPE=LVCMOS33 PULL_MODE=UP;

IO_LOC  "key_n" F4;
IO_PORT "key_n" IO_TYPE=LVCMOS15 PULL_MODE=UP;

IO_LOC  "uart_tx" U15;
IO_PORT "uart_tx" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;

IO_LOC  "uart_rx" V14;
IO_PORT "uart_rx" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;

// The four on-board LEDs, verified blinking on this board by the led_test
// project. (V13 is NOT fitted here - it belongs to the Console Dock Board -
// and U21 is rejected by the placer as a dedicated CPU/SSPI pin.)
IO_LOC  "led[0]" T18;
IO_PORT "led[0]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;

IO_LOC  "led[1]" R18;
IO_PORT "led[1]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;

IO_LOC  "led[2]" R17;
IO_PORT "led[2]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;

IO_LOC  "led[3]" P16;
IO_PORT "led[3]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;

// HDMI (TMDS) - same pins as the video projects in this repo
IO_LOC "tmds_d_p_0[0]" J14,H14;
IO_PORT "tmds_d_p_0[0]" IO_TYPE=LVCMOS33D PULL_MODE=NONE DRIVE=8;
IO_LOC "tmds_d_p_0[1]" J15,H15;
IO_PORT "tmds_d_p_0[1]" IO_TYPE=LVCMOS33D PULL_MODE=NONE DRIVE=8;
IO_LOC "tmds_d_p_0[2]" K17,J17;
IO_PORT "tmds_d_p_0[2]" IO_TYPE=LVCMOS33D PULL_MODE=NONE DRIVE=8;
IO_LOC "tmds_clk_p_0" G15,G16;
IO_PORT "tmds_clk_p_0" IO_TYPE=LVCMOS33D PULL_MODE=NONE DRIVE=8;
